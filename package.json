{
  "name": "jesus-house",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:coverage": "ng test --coverage",
    "test:e2e": "bddgen --config=playwright.config.ts && playwright test --config=playwright.config.ts",
    "test:demo": "DEMO=1 bddgen --config=playwright.demo.config.ts && DEMO=1 playwright test --config=playwright.demo.config.ts",
    "serve:ssr:jesus-house": "node dist/jesus-house/server/server.mjs",
    "lint": "eslint",
    "typecheck": "ng build --configuration development"
  },
  "private": true,
  "packageManager": "npm@10.9.9",
  "dependencies": {
    "@angular/common": "^22.1.5",
    "@angular/compiler": "^22.1.5",
    "@angular/core": "^22.1.5",
    "@angular/forms": "^22.1.5",
    "@angular/platform-browser": "^22.1.5",
    "@angular/platform-server": "^22.1.5",
    "@angular/router": "^22.1.5",
    "@angular/ssr": "^22.1.7",
    "@fontsource/fraunces": "^5.3.0",
    "@fontsource/mulish": "^5.3.0",
    "@lottiefiles/dotlottie-web": "^0.80.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "embla-carousel": "^8.6.0",
    "embla-carousel-autoplay": "^8.6.0",
    "express": "^5.2.1",
    "motion": "^13.2.0",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular-eslint/eslint-plugin": "^22.2.0",
    "@angular-eslint/template-parser": "^22.2.0",
    "@angular-eslint/utils": "^22.1.0",
    "@angular/build": "^22.1.7",
    "@angular/cli": "^22.1.7",
    "@angular/compiler-cli": "^22.1.5",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/express": "^5.0.6",
    "@types/node": "^26.4.1",
    "@typescript-eslint/eslint-plugin": "^8.69.0",
    "@typescript-eslint/parser": "^8.69.0",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^30.0.1",
    "playwright-bdd": "^9.2.0",
